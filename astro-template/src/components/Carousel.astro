---
// Generic reusable carousel — powered by Embla Carousel
// (github.com/davidjerleke/embla-carousel: framework-agnostic, ~6kb,
// no React needed). Multiple <Carousel> instances on one page all work
// independently; the script below initializes every one it finds.
//
// Usage — each direct child is one slide, wrapped in .embla__slide:
//
//   <Carousel>
//     <div class="embla__slide"><TestimonialCard ... /></div>
//     <div class="embla__slide"><TestimonialCard ... /></div>
//   </Carousel>

interface Props {
  loop?: boolean;
  showArrows?: boolean;
  showDots?: boolean;
}

const { loop = true, showArrows = true, showDots = true } = Astro.props;
---

<div class="embla" data-carousel data-loop={String(loop)}>
  <div class="embla__viewport">
    <div class="embla__container">
      <slot />
    </div>
  </div>

  {(showArrows || showDots) && (
    <div class="embla__controls">
      {showArrows && (
        <button class="embla__button embla__button--prev" data-carousel-prev aria-label="Previous slide">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
      )}
      {showDots && <div class="embla__dots" data-carousel-dots></div>}
      {showArrows && (
        <button class="embla__button embla__button--next" data-carousel-next aria-label="Next slide">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      )}
    </div>
  )}
</div>

<style>
  .embla { position: relative; }
  .embla__viewport { overflow: hidden; }
  .embla__container { display: flex; }
  .embla__container > :global(.embla__slide) {
    flex: 0 0 100%;
    min-width: 0;
    padding: 0 .5rem;
  }
  /* Default: 1 slide on mobile, 2 from tablet up. Override per-page by
     targeting .embla__slide with a more specific selector if a given
     carousel wants a different slides-per-view. */
  @media (min-width: 720px) {
    .embla__container > :global(.embla__slide) { flex: 0 0 50%; }
  }

  .embla__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }
  .embla__button {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color .2s, background .2s;
    flex-shrink: 0;
  }
  .embla__button:hover { border-color: var(--gold-dark); background: var(--bg-card-2); }
  .embla__button:disabled { opacity: .35; cursor: default; }

  .embla__dots { display: flex; align-items: center; gap: .5rem; }
  .embla__dots :global(.embla__dot) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--border-light);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background .2s, transform .2s;
  }
  .embla__dots :global(.embla__dot--selected) {
    background: var(--gold);
    transform: scale(1.3);
  }
</style>

<script>
  import EmblaCarousel from 'embla-carousel';

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const viewport = root.querySelector<HTMLElement>('.embla__viewport');
    if (!viewport) return;

    const loop = root.dataset.loop === 'true';
    const embla = EmblaCarousel(viewport, { loop });

    const prevBtn = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    prevBtn?.addEventListener('click', () => embla.scrollPrev());
    nextBtn?.addEventListener('click', () => embla.scrollNext());

    function updateButtons() {
      if (loop) return; // prev/next always usable when looping
      prevBtn?.toggleAttribute('disabled', !embla.canScrollPrev());
      nextBtn?.toggleAttribute('disabled', !embla.canScrollNext());
    }

    const dotsNode = root.querySelector<HTMLElement>('[data-carousel-dots]');
    let dots: HTMLButtonElement[] = [];
    if (dotsNode) {
      dots = embla.scrollSnapList().map((_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'embla__dot';
        dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
        dot.addEventListener('click', () => embla.scrollTo(i));
        dotsNode.appendChild(dot);
        return dot;
      });
    }

    function updateSelected() {
      const selected = embla.selectedScrollSnap();
      dots.forEach((dot, i) => dot.classList.toggle('embla__dot--selected', i === selected));
      updateButtons();
    }

    embla.on('select', updateSelected);
    embla.on('reInit', updateSelected);
    updateSelected();
  });
</script>

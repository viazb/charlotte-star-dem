---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Button from '../components/Button.astro';
import Carousel from '../components/Carousel.astro';
import TestimonialCard from '../components/TestimonialCard.astro';

const testimonials = [
  {
    text: "Dan and his team did a great repair job on my Mercedes. The actual cost was less than the original estimate and Dan connected me with a vendor to work on another issue.",
    author: 'Mercedes Owner',
  },
  {
    text: "I wish I had known about this wonderful place years ago! I've always gone to the dealership for all my maintenance. The staff here is so kind and welcoming, especially Joe!",
    author: 'Verified Customer',
  },
  {
    text: 'I cannot stress enough how much I encourage you to use this company. Kind people that have conversations with us that aren’t car people. They fixed my Mercedes twice at a much lower cost than expected.',
    author: '2007 Mercedes S550 Owner',
  },
  {
    text: 'Andy is the best mechanic around! They will treat your car as their own. Honest, reliable, not overpriced.',
    author: 'Repeat Customer',
  },
];

// Even 3-up grid, same as the live site's .services-grid — an earlier
// version of this page used an asymmetric "bento" layout here, but with
// cards this uneven in item count (12 vs 5 vs 4) the tall/short cells
// just left big awkward gaps instead of reading as intentional.
const services = [
  {
    title: 'Mechanical Maintenance',
    desc: 'Full-service mechanical repair and maintenance for all systems.',
    icon: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z',
    items: [
      'Air Conditioning & Heating', 'Battery Replacement', 'Brake Repair & Service',
      'Clutch Repair', 'Coolant & Radiator', 'Engine Inspection',
      'Fuel System Service', 'Diagnostics & Lighting', 'Oil Changes',
      'Power Steering', 'Hose Services', 'Pre-Purchase Inspection',
    ],
  },
  {
    title: 'Engine Maintenance',
    desc: 'Precision diagnosis and repair of all engine-related symptoms.',
    icon: 'M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2',
    items: [
      'Check Engine Light Diagnosis', 'Exhaust Smoke Issues',
      'Strange Noises Investigation', 'Stalling & Power Loss', 'Vibration Diagnosis',
    ],
  },
  {
    title: 'Preventive Maintenance',
    desc: 'Milestone service intervals to keep your vehicle at peak performance.',
    icon: 'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z',
    iconCheck: true,
    items: [
      'Complete inspection & fluid service', 'Filters, belts, and wear items',
      'Manufacturer-specified checks', 'Detailed condition report',
    ],
    miles: ['15K mi', '30K mi', '60K mi', '90K mi', '120K mi'],
  },
];

// The old 4.9★/374-reviews pair was never verified against a real
// source — merged into one qualitative claim instead of a specific
// count, per the client's instruction not to publish unverified numbers.
const heroTrust = [
  { num: '44', label: 'Years', icon: 'clock' },
  { num: '5★', label: 'Hundreds of Reviews', icon: 'star' },
  { num: '12-Mo', label: 'Unlimited-Mile Warranty', icon: 'shield' },
];

// Compact bento stat grid for the About Teaser aside — the one place on
// this page that keeps the asymmetric bento treatment, since these 4
// values are all short single numbers (no uneven-content-density issue
// like Services had).
// "44" listed first and marked lg — CSS Grid auto-placement fills the
// remaining 1x1 cells in DOM order, so the large cell must come first
// or the browser slots it in wherever it fits next, scrambling the
// layout.
const aboutStats = [
  { value: '44', label: 'Years Serving Charlotte' },
  { value: '1982', label: 'Est. Year' },
  { value: '2', label: 'Brands We Master' },
  { value: '5★', label: 'Hundreds of Happy Customers' },
];
---

<BaseLayout title="Charlotte Star Service — BMW & Mercedes-Benz Specialists Since 1982">
  <SiteHeader />

  <!-- ── HERO — photo + overlay + trust strip, matching the live site's
       hero exactly (parity, not a redesign): the earlier "Editorial"
       typographic-only version dropped the car photo and moved the
       trust numbers into a separate bento block below — restored here. ── -->
  <section class="hero" id="home">
    <div class="hero-photo" aria-hidden="true"></div>
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="hero-main">
      <div class="container">
        <div class="hero-content">
          <div class="hero-eyebrow" data-reveal>
            <span class="hero-eyebrow-line"></span>
            <span class="hero-eyebrow-text">Charlotte, NC &mdash; Established 1982</span>
          </div>
          <h1 data-reveal style="transition-delay: 80ms;">
            44 Years of <em>Trust.</em><br />One Standard<br />of Excellence.
          </h1>
          <p class="hero-sub" data-reveal style="transition-delay: 160ms;">
            Charlotte's dedicated BMW and Mercedes-Benz specialists. Dealer-level expertise
            at independent shop prices — with a 12-month, unlimited-mile warranty on every part and every repair.
          </p>
          <div class="hero-ctas" data-reveal style="transition-delay: 240ms;">
            <Button href="tel:7043324111" variant="primary">Call Now</Button>
            <Button href="https://maps.google.com/maps?daddr=4225+Monroe+Rd,+Charlotte,+NC+28205" variant="outline" target="_blank" rel="noopener">
              Get Directions
            </Button>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-trust-strip">
      <div class="container">
        <div class="hero-trust-grid">
          {heroTrust.map((t) => (
            <div class="hero-trust-item">
              {t.icon === 'clock' && <svg class="hero-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>}
              {t.icon === 'star' && <svg class="hero-trust-icon" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>}
              {t.icon === 'users' && <svg class="hero-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>}
              {t.icon === 'shield' && <svg class="hero-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>}
              <div>
                <div class="hero-trust-num">{t.num}</div>
                <div class="hero-trust-label">{t.label}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── SERVICES — even 3-up grid, same as the live site. ── -->
  <section id="services">
    <div class="container">
      <div class="text-center" data-reveal>
        <span class="section-label">What We Do</span>
        <h2 class="section-title">Expert Service for BMW &amp; Mercedes-Benz</h2>
        <div class="divider center"></div>
        <p class="section-subtitle">
          We specialize exclusively in German luxury vehicles — which means deeper knowledge,
          faster diagnosis, and better outcomes for your BMW or Mercedes-Benz.
        </p>
      </div>
      <div class="services-grid" data-reveal style="transition-delay: 90ms;">
        {services.map((s) => (
          <div class="service-card">
            <div class="service-card-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d={s.icon} />
                {s.iconCheck && <path d="m9 12 2 2 4-4" />}
              </svg>
            </div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <div class="service-items single-col">
              {s.items.map((item) => (
                <div class="service-item">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                  <span>{item}</span>
                </div>
              ))}
            </div>
            {s.miles && (
              <div class="service-miles">
                {s.miles.map((m) => <span class="mile-badge">{m}</span>)}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="testimonials">
    <div class="container">
      <div class="text-center" data-reveal>
        <span class="section-label">Client Reviews</span>
        <h2 class="section-title">What Our Customers Say</h2>
        <div class="divider center"></div>
        <p class="section-subtitle">
          Hundreds of 5-star reviews. Here is what Charlotte BMW and Mercedes-Benz owners have to say.
        </p>
      </div>
      <div style="margin-top: 3rem; transition-delay: 120ms;" data-reveal>
        <Carousel>
          {testimonials.map((t) => (
            <div class="embla__slide">
              <TestimonialCard text={t.text} author={t.author} />
            </div>
          ))}
        </Carousel>
      </div>
      <div class="reviews-links" data-reveal>
        <a href="https://www.google.com/maps/place/Charlotte+Star+Service/@35.196168,-80.7887252,17z" target="_blank" rel="noopener" class="reviews-link">
          View Our Reviews on Google &rarr;
        </a>
        <!-- Rating/count as of the time this was added — Carfax doesn't offer an embeddable
             widget, so this is a static snapshot; update by hand if it drifts noticeably. -->
        <a href="https://www.carfax.com/Reviews-Charlotte-Star-Service-Charlotte-NC_TNS4J8MEGX" target="_blank" rel="noopener" class="reviews-link reviews-link-carfax">
          <!-- CARFAX's actual current logo (pulled from static.carfax.com) on its own white
               chip, since the mark's black background tiles would vanish on this dark theme. -->
          <span class="carfax-chip">
            <svg width="75" height="14" viewBox="0 0 379 71" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" aria-label="CARFAX"><defs><path id="cfx-a" d="M0 71h378.8V0H0z"/></defs><g fill="none" fill-rule="evenodd"><path d="M7.1 0C3.2 0 0 3.1 0 7v57c0 3.8 3.2 7 7.1 7h351.4c3.9 0 7.1-3.1 7.1-7V7c0-3.8-3.2-7-7.1-7H7.1z" fill="#FFF"/><path d="M3 64V7c0-2.2 1.8-3.9 4.1-3.9h351.4c2.2 0 4.1 1.8 4.1 3.9v57c0 2.2-1.8 3.9-4.1 3.9H7.1C4.8 67.9 3 66.2 3 64zM7.1 0C3.2 0 0 3.1 0 7v57c0 3.8 3.2 7 7.1 7h351.4c3.9 0 7.1-3.1 7.1-7V7c0-3.8-3.2-7-7.1-7H7.1z" fill="#000"/><mask id="cfx-b" fill="#fff"><use xlink:href="#cfx-a"/></mask><path fill="#000" mask="url(#cfx-b)" d="M65.6 65.1h56.7V5.901H65.6zm59.1 0h56.7V5.901h-56.7zm59.6 0H241V5.901h-56.7zm59.5 0h56.7V5.901h-56.7z"/><path d="M358.1 63.5h-8.5l-11.9-17 13.7-19.2h-13.6l-2.4 3.8c-1.5 2.5-3.2 5.1-4.2 7.2-.9-2.1-2.6-4.7-4.1-7.2l-2.4-3.8h-13.9l13.7 19.5-12.2 16.7h-7.8V7.3h53.6v56.2z" fill="#FFF" mask="url(#cfx-b)"/><path fill="#000" mask="url(#cfx-b)" d="M6 65.1h56.7V5.901H6z"/><path d="M35.7 56.3c-11.8 0-18-8.7-18-20.4 0-12.7 7.5-20.4 18.1-20.4 9.7 0 13.6 4.2 16.3 11.6l-10 3.9c-1.4-3.7-2.8-6-6.4-6-4.6 0-6.6 4.6-6.6 10.9 0 6.1 1.9 10.9 6.7 10.9 3.4 0 4.9-1.9 7.1-5.6l9.3 4.9c-2.7 5.1-7.1 10.2-16.5 10.2m78.3-1.1L99.6 15.6H88.5L74.1 55.2H86l2.1-7H100l2.1 7H114zM97.3 39.5h-6.6l.7-2.6c1.4-5 2-7.2 2.5-9.9.5 2.7 1.1 4.8 2.5 9.9l.9 2.6zm73 15.9l-7.9-15.1c4.4-2 7.1-5.6 7.1-11.6 0-9.4-6.2-12.9-15.4-12.9h-17.7v39.6h10.8V42h4.4l6.5 13.4h12.2zM158.6 29c0 2.8-1.4 4.4-5 4.4h-6.5v-8.7h6.6c3.6 0 4.9 1.8 4.9 4.3zm49.2-3.9v5.5h12.4v9.3h-12.4v15.5h-10.9V15.8h31.3v9.3zm83.9 30.4l-14.4-39.6h-11.1l-14.3 39.6h11.8l2.1-7h11.9l2.1 7h11.9zM275 39.8h-6.6l.7-2.6c1.4-5 2-7.2 2.5-9.9.5 2.7 1.1 4.8 2.5 9.9l.9 2.6z" fill="#FFF" mask="url(#cfx-b)"/><path d="M358.1 63.5h-8.5l-11.9-17 13.7-19.2h-13.6l-2.4 3.8c-1.5 2.5-3.2 5.1-4.2 7.2-.9-2.1-2.6-4.7-4.1-7.2l-2.4-3.8h-13.9l13.7 19.5-12.2 16.7h-7.8V7.3h53.6v56.2zm-32.4 0l1-1.4c1.6-2.5 3.2-5.2 4.2-7.3 1.1 2.1 2.6 4.8 4.1 7.3l.9 1.4h-10.2zM302.9 65h56.7V5.8h-56.7V65z" fill="#000" mask="url(#cfx-b)"/><path d="M373.2 5.2c.9 0 1.6 0 1.6-1 0-.8-.7-.9-1.4-.9h-1.3v1.9h1.1zm-2-2.8h2.4c1.4 0 2.1.6 2.1 1.8 0 1.1-.7 1.6-1.7 1.7l1.8 2.7h-1L373.1 6h-1v2.6h-1V2.4h.1zm6.6 3.1c0-2.5-2-4.5-4.4-4.5-2.5 0-4.4 2-4.4 4.5s2 4.5 4.4 4.5c2.4 0 4.4-2 4.4-4.5zM373.4.1c3 0 5.4 2.4 5.4 5.4 0 3-2.4 5.4-5.4 5.4-3 0-5.4-2.4-5.4-5.4 0-3 2.4-5.4 5.4-5.4z" fill="#FFF" mask="url(#cfx-b)"/></g></svg>
          </span>
          5★ Rating on Carfax &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ── ABOUT TEASER — compact bento stat column beside the story copy. ── -->
  <section id="about-teaser">
    <div class="container">
      <div class="at-inner">
        <div class="at-stats" data-reveal>
          {aboutStats.map((s, i) => (
            <div class={`at-cell ${i === 0 ? 'at-lg' : ''}`}>
              <div class="at-value">{s.value}</div>
              <div class="at-label">{s.label}</div>
            </div>
          ))}
        </div>
        <div class="at-content" data-reveal style="transition-delay: 90ms;">
          <span class="section-label">Our Story</span>
          <h2 class="section-title">The People Behind<br />Your Vehicle</h2>
          <div class="divider"></div>
          <p>
            Since 1982, Charlotte Star Service has been the trusted home for BMW and
            Mercedes-Benz owners across the Charlotte area. What started as a commitment
            to honest, expert European auto repair has grown into 44 years of loyal
            relationships built on fair pricing and genuine care.
          </p>
          <p>
            <strong class="white">Dan</strong> leads the team with decades of
            hands-on expertise in German luxury vehicles. At the front desk,{' '}
            <strong class="white">Joe</strong> is the welcoming face customers rave
            about — the kind of service rep who actually listens and explains everything
            clearly, whether you're a car person or not.
          </p>
          <Button href="/about" variant="outline">
            Read Our Full Story
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-left: .1rem;"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CONTACT / APPOINTMENT ── -->
  <section id="contact">
    <div class="container">
      <div class="text-center" data-reveal>
        <span class="section-label">Get In Touch</span>
        <h2 class="section-title">Schedule Your Service</h2>
        <div class="divider center"></div>
        <p class="section-subtitle">
          Ready to experience the difference 44 years of expertise makes?
          Give us a call or schedule your appointment below.
        </p>
      </div>
      <div class="contact-grid" data-reveal style="transition-delay: 90ms;">
        <div class="contact-details">
          <div class="contact-item">
            <div class="contact-item-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.44 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.13 1 .37 1.96.72 2.9a2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6.09 6.09l.98-.98a2 2 0 0 1 2.11-.45c.94.35 1.9.59 2.9.72A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="contact-item-text">
              <h4>Phone</h4>
              <a href="tel:7043324111" class="phone-display">704-332-4111</a>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-item-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="contact-item-text">
              <h4>Address</h4>
              <p>4225 Monroe Rd<br />Charlotte, NC 28205</p>
              <a href="https://maps.google.com/maps?daddr=4225+Monroe+Rd,+Charlotte,+NC+28205" target="_blank" rel="noopener" class="directions-link">Get Directions &rarr;</a>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-item-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div class="contact-item-text">
              <h4>Business Hours</h4>
              <p>Monday – Friday: 8:00am – 5:00pm<br />Saturday &amp; Sunday: Closed</p>
            </div>
          </div>
          <div class="contact-cta-block">
            <p>Call us to schedule your appointment — we give every vehicle the dedicated time it deserves.</p>
            <div class="contact-cta-buttons">
              <Button href="tel:7043324111" variant="primary">
                <svg slot="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.44 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.13 1 .37 1.96.72 2.9a2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6.09 6.09l.98-.98a2 2 0 0 1 2.11-.45c.94.35 1.9.59 2.9.72A2 2 0 0 1 22 16.92z"/></svg>
                Call Now
              </Button>
              <!-- TODO: Replace with Calendly popup script when client provides account.
                   Label reads "Call to Schedule" (not "Schedule Appointment") because this
                   is still a tel: link, not a real scheduler — see nearby TODO above. -->
              <Button href="tel:7043324111" variant="outline">
                <svg slot="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Call to Schedule
              </Button>
            </div>
          </div>
        </div>
        <div class="contact-map">
          <iframe src="https://maps.google.com/maps?q=4225+Monroe+Rd,+Charlotte,+NC+28205&output=embed" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Charlotte Star Service Location"></iframe>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
  /* ── Hero: photo + overlay + trust strip (ported from the live site) ── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    border-bottom: none;
  }
  .hero-photo {
    position: absolute;
    inset: 0;
    /* Stock BMW-on-palm-tree-lined-street photo removed — not the
       client's shop, and Charlotte doesn't have palm trees. Waiting
       on a real photo at this path; overlay below is unchanged. */
    background-image: url('/assets/img/hero.jpg');
    background-size: cover;
    background-position: center 40%;
    background-repeat: no-repeat;
    background-color: var(--black);
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0, 0, 0, .92) 0%, rgba(0, 0, 0, .75) 30%, rgba(0, 0, 0, .35) 65%, rgba(0, 0, 0, .05) 100%);
  }
  .hero-main {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    align-items: center;
    padding: calc(var(--header-height) + 3rem) 0 3.5rem;
  }
  .hero-content { max-width: 680px; }
  .hero-eyebrow { display: flex; align-items: center; gap: .7rem; margin-bottom: 1.4rem; }
  .hero-eyebrow-line { width: 28px; height: 1px; background: var(--gold); }
  .hero-eyebrow-text { font-size: .66rem; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; color: var(--gold); }

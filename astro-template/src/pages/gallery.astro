---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Button from '../components/Button.astro';

// Real shop photos, curated from a larger drop of 20. The rest were
// excluded: several showed customer cars with visible license plates
// (privacy), a couple weren't shop-related at all (a gas station, a
// mall display for an unrelated brand), one was a photo of a TV
// screensaver, and foto-10/foto-14 were exact duplicates.
const photos = [
  { src: '/images/gallery-01-lift.jpg', label: 'G63 AMG — On the Lift' },
  { src: '/images/gallery-05-amg.jpg', label: 'AMG GT — Full Service' },
  { src: '/images/gallery-02-bay.jpg', label: 'Ready for Service' },
  { src: '/images/gallery-03-engine-open.jpg', label: 'Engine Bay Diagnostics' },
  { src: '/images/gallery-04-precision.jpg', label: 'Precision Engine Work' },
  { src: '/images/gallery-08-v8.jpg', label: 'V8 Power Under the Hood' },
  { src: '/images/gallery-07-underhood.jpg', label: 'Under the Hood' },
  { src: '/images/gallery-06-team.jpg', label: 'Our Team at Work' },
];
---

<BaseLayout
  title="Gallery — Charlotte Star Service | BMW & Mercedes-Benz Specialists"
  description="Real photos from Charlotte Star Service — BMW and Mercedes-Benz repair specialists in Charlotte, NC. Our shop, our team, and the work we do."
>
  <SiteHeader />

  <!-- ── PAGE HERO — real shop photo (a G63 AMG on the lift), replacing
       the Unsplash placeholder the plain-HTML site still uses. ── -->
  <div class="page-hero">
    <div class="page-hero-photo" role="img" aria-label="A Mercedes-AMG G63 on the lift at Charlotte Star Service"></div>
    <div class="page-hero-bg"></div>
    <div class="container">
      <div class="page-hero-content" data-reveal>
        <span class="section-label">Our Work</span>
        <h1>A Look Inside<br /><em>Charlotte Star Service</em></h1>
        <div class="divider center"></div>
        <p>
          Real photos of our shop, our team, and the vehicles we work on —
          straight from the bays at 4225 Monroe Rd.
        </p>
      </div>
    </div>
  </div>

  <!-- ── GALLERY ── -->
  <section class="gallery-section">
    <div class="container">
      <div class="gallery-intro" data-reveal>
        <p>
          Hundreds of 5-star reviews and 44 years in the same bays — here's a look
          at the shop behind them.
        </p>
        <a href="tel:7043324111" class="gallery-intro-phone">704-332-4111</a>
      </div>

      <div class="gallery-grid" data-reveal style="transition-delay: 90ms;">
        {photos.map((p) => (
          <div class="gallery-item">
            <img src={p.src} alt={p.label} loading="lazy" />
            <div class="gallery-item-overlay"><span class="gallery-item-label">{p.label}</span></div>
          </div>
        ))}
      </div>

      <!-- Call to Action below grid -->
      <div class="gallery-cta" data-reveal style="transition-delay: 120ms;">
        <span class="section-label">See Us In Person</span>
        <h3>Come Visit the Shop</h3>
        <div class="divider center"></div>
        <p>
          The best way to see our work is to stop by at 4225 Monroe Rd, Charlotte, NC 28205 —
          or give us a call. We are open Monday through Friday, 8:00am to 5:00pm.
        </p>
        <div class="gallery-cta-buttons">
          <Button href="tel:7043324111" variant="primary">
            <svg slot="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.44 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.13 1 .37 1.96.72 2.9a2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6.09 6.09l.98-.98a2 2 0 0 1 2.11-.45c.94.35 1.9.59 2.9.72A2 2 0 0 1 22 16.92z" /></svg>
            Call 704-332-4111
          </Button>
          <Button href="https://maps.google.com/maps?daddr=4225+Monroe+Rd,+Charlotte,+NC+28205" variant="outline" target="_blank" rel="noopener">
            Get Directions
          </Button>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
  /* ── Page hero ── */
  .page-hero {
    padding: calc(var(--header-height) + 3rem) 0 2.25rem;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .page-hero-photo {
    position: absolute;
    inset: 0;
    background-image: url('/images/gallery-01-lift.jpg');
    background-size: cover;
    background-position: center 30%;
    opacity: .4;
  }
  .page-hero-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(160deg, rgba(6, 6, 6, 0) 0%, var(--bg) 100%),
      radial-gradient(ellipse at 70% -10%, rgba(201, 168, 76, .07) 0%, transparent 55%);
  }
  .page-hero-content { position: relative; z-index: 1; text-align: center; }
  .page-hero h1 { margin-bottom: .65rem; }
  .page-hero h1 em { font-style: italic; color: var(--gold); }
  .page-hero p { max-width: 560px; margin-inline: auto; font-size: 1rem; color: var(--text); }

  /* ── Gallery ── */
  .gallery-section { background: var(--bg); }
  .gallery-intro { text-align: center; max-width: 560px; margin-inline: auto; margin-bottom: 3rem; }
  .gallery-intro p { color: var(--text-muted); font-size: 1rem; margin-bottom: 1.25rem; }
  .gallery-intro-phone { font-family: var(--font-serif); font-size: 1.25rem; color: var(--gold); font-weight: 600; }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .gallery-item { aspect-ratio: 4 / 3; position: relative; overflow: hidden; cursor: pointer; background: var(--bg-card); }
  /* 8 photos don't fill a 3-column grid evenly — rather than leave an
     empty cell in the last row, the closing photo spans the gap. Its
     aspect-ratio widens to match (not just grid-column: span, which
     would double its height too via aspect-ratio: 4/3 and leave a
     gap under the shorter neighboring cell instead). */
  .gallery-item:last-child { grid-column: span 2; aspect-ratio: 8 / 3; }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .45s ease; }
  .gallery-item:hover img { transform: scale(1.05); }
  .gallery-item-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .3s;
  }
  .gallery-item:hover .gallery-item-overlay { background: rgba(0, 0, 0, .6); }
  .gallery-item-label {
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: transparent;
    transition: color .3s;
    text-align: center;
    padding-inline: 1.5rem;
  }
  .gallery-item:hover .gallery-item-label { color: #f0ebe0; }

  .gallery-cta {
    text-align: center;
    margin-top: 4rem;
    padding: 3rem 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    max-width: 680px;
    margin-inline: auto;
  }
  .gallery-cta h3 { color: var(--white); margin-bottom: .75rem; font-size: 1.6rem; }
  .gallery-cta p { color: var(--text-muted); margin-bottom: 1.75rem; font-size: .95rem; }
  .gallery-cta-buttons { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }

  @media (max-width: 768px) {
    /* 8 photos fill a 2-column grid exactly (4 rows) — no gap to
       close here, so the last item goes back to a normal single cell. */
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
    .gallery-item:last-child { grid-column: span 1; aspect-ratio: 4 / 3; }
  }
  @media (max-width: 480px) {
    .gallery-grid { grid-template-columns: 1fr; }
  }
</style>

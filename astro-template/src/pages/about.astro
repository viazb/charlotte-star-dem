---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Button from '../components/Button.astro';

const milestones = [
  { year: '1982', text: 'Charlotte Star Service founded, specializing exclusively in German luxury vehicles.' },
  { year: '1990s', text: "Established reputation as Charlotte's go-to BMW and Mercedes independent shop." },
  { year: '2000s', text: 'Grew to become a trusted alternative to dealerships — same quality, lower prices.' },
  { year: 'Today', text: 'Hundreds of 5-star reviews and a 12-month, unlimited-mile warranty that backs every job we do.' },
];

const team = [
  {
    initials: 'DF',
    title: 'Shop Manager & Lead Technician',
    name: 'Dan',
    bio: [
      "Dan is the engine behind Charlotte Star Service — in every sense of the word. With decades of hands-on experience diagnosing and repairing BMW and Mercedes-Benz vehicles, his expertise is the foundation the shop is built on.",
      "Customers consistently praise Dan for his transparency. When a repair comes in under the original estimate, that is not a coincidence — it is Dan's commitment to never padding a bill. He will tell you exactly what needs to be done, why it needs to be done, and what it will cost before any work begins. He also goes further than most: when he spots an issue outside his scope, he connects customers with trusted vendors rather than leaving them on their own.",
    ],
  },
  {
    initials: 'J',
    title: 'Customer Service',
    name: 'Joe',
    bio: [
      "Joe is the welcoming face of Charlotte Star Service — and the first person you will meet when you walk through the door or pick up the phone. In a business where customer trust is everything, Joe has earned his reputation as someone who makes people feel genuinely at ease.",
      'Not everyone who brings in a BMW or Mercedes is a "car person," and Joe knows that. He takes the time to explain what is happening with your vehicle in plain language, answers every question without impatience, and ensures that from drop-off to pickup, your experience feels as premium as the vehicle you drive. Multiple reviews single him out by name — and that is not an accident.',
    ],
  },
];

const values = [
  {
    icon: 'shield',
    title: 'Honest Pricing',
    text: 'We give you a clear estimate before we start, and we stick to it. Repairs that come in under estimate are charged at the lower amount — always.',
  },
  {
    icon: 'alert',
    title: 'No Upselling',
    text: 'We only recommend what your car actually needs. We do not manufacture urgency or pressure you into services your vehicle does not require.',
  },
  {
    icon: 'heart',
    title: 'Treat It As Our Own',
    text: 'Every vehicle that comes through our doors is handled with the same care we would give our own. No shortcuts, no rushed jobs.',
  },
  {
    icon: 'clock',
    title: 'Dealer Quality, Independent Price',
    text: "Our focus on BMW and Mercedes-Benz exclusively means our technicians' knowledge runs just as deep as a dealership's — at a fraction of the cost.",
  },
  {
    icon: 'users',
    title: 'People-First Communication',
    text: 'We explain everything in plain language. You should understand exactly what is happening with your vehicle and why — no jargon, no dismissiveness.',
  },
  {
    icon: 'refresh',
    title: 'Community Commitment',
    text: 'We have been part of the Charlotte community for over 44 years. Long-term relationships with our customers — not one-time transactions — are what we are about.',
  },
];
---

<BaseLayout
  title="About Us — Charlotte Star Service | BMW & Mercedes-Benz Since 1982"
  description="Learn about Charlotte Star Service — 44 years serving Charlotte's BMW and Mercedes-Benz owners. Meet Dan and Joe, and learn about our 12-month, unlimited-mile warranty."
>
  <SiteHeader />

  <!-- ── PAGE HERO — real shop photo (an AMG GT on the lift), replacing
       the Unsplash placeholder the plain-HTML site still uses. ── -->
  <div class="page-hero">
    <div class="page-hero-photo" role="img" aria-label="A Mercedes-AMG GT on the lift at Charlotte Star Service"></div>
    <div class="page-hero-bg"></div>
    <div class="container">
      <div class="page-hero-content" data-reveal>
        <span class="section-label">Our Story</span>
        <h1>Built on Honesty.<br /><em>Driven by Expertise.</em></h1>
        <div class="divider center"></div>
        <p>
          Since 1982, Charlotte Star Service has been the trusted destination for BMW and
          Mercedes-Benz owners who demand dealer-level care without the dealer-level prices.
        </p>
      </div>
    </div>
  </div>

  <!-- ── STORY ── -->
  <section class="story-section">
    <div class="container">
      <div class="story-inner">
        <div class="story-aside" data-reveal>
          <div class="story-quote">
            <p>"We treat your car as our own — with the same care, the same precision, and the same honesty we would expect for ourselves."</p>
          </div>
          <div class="story-milestones">
            {milestones.map((m) => (
              <div class="milestone">
                <div class="milestone-year">{m.year}</div>
                <div class="milestone-text">{m.text}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="story-content" data-reveal style="transition-delay: 90ms;">
          <span class="section-label">Founded in Charlotte</span>
          <h2 class="section-title">44 Years<br />of German Expertise</h2>
          <div class="divider"></div>
          <p>
            Charlotte Star Service opened its doors in 1982 with a straightforward mission:
            give BMW and Mercedes-Benz owners in Charlotte a shop they could truly trust.
            A place where the diagnostic was honest, the pricing was fair, and the work
            was done right the first time.
          </p>
          <p>
            More than 44 years later, that mission has never changed. We have spent
            over 44 years becoming deeply fluent in the engineering language of German
            luxury vehicles — their systems, their quirks, their service histories, and
            their common failure points. That depth of knowledge is what separates a
            specialist from a general repair shop.
          </p>
          <p>
            Customers who have spent years paying dealership rates often tell us the same
            thing the first time they come to us: "I wish I had known about you sooner."
            We charge significantly less than the dealership, and because we focus entirely
            on BMW and Mercedes-Benz, we often know these vehicles better than a large
            dealership with dozens of technicians spread across every make and model.
          </p>
          <p>
            We are located at 4225 Monroe Rd in Charlotte — the same address we have
            called home since 1982, serving generations of Charlotte families and their
            vehicles. When you walk through our door, you are met by people who genuinely
            care about getting you back on the road safely, at a price that respects your budget.
          </p>
          <p>
            Every repair, every service, and every diagnostic we perform is backed by our{' '}
            <strong class="white">12-month, unlimited-mile warranty on all parts and labor</strong>.
            That is our commitment to the quality of our work and our confidence in the people
            doing it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── TEAM ── -->
  <section class="team-section">
    <div class="container">
      <div class="text-center" data-reveal>
        <span class="section-label">The Team</span>
        <h2 class="section-title">The People You Can Count On</h2>
        <div class="divider center"></div>
        <p class="section-subtitle">
          A small, dedicated team who know your vehicle by name — and know you by name too.
        </p>
      </div>

      <!-- Real shop-floor photo — not captioned with a name, since the
           two bios below (Dan, Joe) are the site's existing verified
           copy and this technician isn't one of the two pictured here;
           it's here to show the real shop, not to stand in for either bio. -->
      <div class="team-photo" data-reveal style="transition-delay: 60ms;">
        <div class="team-photo-img" role="img" aria-label="A Charlotte Star Service technician working on a Mercedes-Benz in the shop"></div>
      </div>

      <div class="team-grid" data-reveal style="transition-delay: 120ms;">
        {team.map((member) => (
          <div class="team-card">
            <div class="team-card-header">
              <div class="team-avatar">{member.initials}</div>
              <div>
                <div class="team-title">{member.title}</div>
                <div class="team-name">{member.name}</div>
              </div>
            </div>
            <div class="team-card-body">
              {member.bio.map((p) => <p style="margin-top: 1rem;">{p}</p>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── VALUES ── -->
  <section class="values-section">
    <div class="container">
      <div class="text-center" data-reveal>
        <span class="section-label">What We Stand For</span>
        <h2 class="section-title">Our Core Values</h2>
        <div class="divider center"></div>
      </div>
      <div class="values-grid" data-reveal style="transition-delay: 90ms;">
        {values.map((v) => (
          <div class="value-card">
            <div class="value-icon">
              {v.icon === 'shield' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><polyline points="9 12 11 14 15 10" /></svg>
              )}
              {v.icon === 'alert' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
              )}
              {v.icon === 'heart' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
              )}
              {v.icon === 'clock' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
              )}
              {v.icon === 'users' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
              )}
              {v.icon === 'refresh' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10" /><polyline points="1 20 1 14 7 14" /><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" /></svg>
              )}
            </div>
            <h4>{v.title}</h4>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── WARRANTY ── -->
  <section class="warranty-section">
    <div class="container">
      <div class="warranty-inner">
        <div class="warranty-content" data-reveal>
          <span class="section-label">Our Guarantee</span>
          <h2 class="section-title">The 12-Month, Unlimited-Mile Warranty</h2>
          <div class="divider"></div>
          <p>
            Every repair and every service performed at Charlotte Star Service comes with a{' '}
            <strong class="white">12-month, unlimited-mile warranty on all parts and labor</strong>.
            This is not a marketing claim — it is a contractual commitment to the quality
            of our work.
          </p>
          <p>
            If something is not right after we service your vehicle, we make it right.
            No arguments, no blame-shifting, no fees. That is what standing behind your
            work looks like.
          </p>
          <div class="warranty-points">
            {[
              'Covers all parts installed during your service',
              'Covers all labor performed on your vehicle',
              'Full 12 months from the date of service, no mileage limit',
              'No deductibles, no hidden terms',
            ].map((point) => (
              <div class="warranty-point">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
                {point}
              </div>
            ))}
          </div>
        </div>
        <div class="warranty-badge-wrap" data-reveal style="transition-delay: 90ms;">
          <div class="warranty-badge">
            <div class="warranty-years">12</div>
            <div class="warranty-badge-label">Month<br />Unlimited-Mile</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SPECIALIZATION ── -->
  <section class="spec-section">
    <div class="container">
      <div class="text-center" data-reveal>
        <span class="section-label">Our Focus</span>
        <h2 class="section-title">Why We Only Do Two Brands</h2>
        <div class="divider center"></div>
      </div>
      <div class="spec-inner" data-reveal style="transition-delay: 90ms;">
        <div>
          <div class="spec-brands">
            <div class="spec-brand">
              <div class="spec-brand-icon">BMW</div>
              <div>
                <div class="spec-brand-name">BMW</div>
                <div class="spec-brand-note">All models, traditional combustion engine</div>
              </div>
            </div>
            <div class="spec-brand">
              <div class="spec-brand-icon">MB</div>
              <div>
                <div class="spec-brand-name">Mercedes-Benz</div>
                <div class="spec-brand-note">All models, traditional combustion engine</div>
              </div>
            </div>
          </div>
          <div class="spec-note">
            We do not service hybrid or electric vehicles. Our expertise is built entirely
            around traditional combustion-engine BMW and Mercedes-Benz models.
          </div>
        </div>
        <div class="spec-content">
          <p>
            Most repair shops try to work on everything. We made a different choice in 1982
            and have never second-guessed it: we would do only BMW and Mercedes-Benz, and
            we would do them better than anyone else in Charlotte.
          </p>
          <p>
            That focus means our technicians spend their entire careers learning the
            engineering, the electronics, and the service history of exactly two brands.
            When your BMW's check engine light comes on, we have seen that code hundreds
            of times. We know the likely cause, the correct fix, and what to watch for.
          </p>
          <p>
            Specialization also means we stock the right parts, use the right tools, and
            have the right software for your vehicle — without having to adapt or compromise.
          </p>
          <p>
            If you drive a hybrid or electric vehicle, we respect that — but we are not
            the right shop for you. We stay in our lane so we can be exceptional in it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="contact" id="contact">
    <div class="container cta-container" data-reveal>
      <span class="section-label">Ready to Experience the Difference?</span>
      <h2 class="section-title">Let Us Take Care of Your Vehicle</h2>
      <div class="divider center"></div>
      <p class="cta-sub">
        Call Dan, Joe, and the team at Charlotte Star Service. Monday through Friday,
        8:00am to 5:00pm.
      </p>
      <div class="cta-buttons">
        <Button href="tel:7043324111" variant="primary">
          <svg slot="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.44 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.13 1 .37 1.96.72 2.9a2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6.09 6.09l.98-.98a2 2 0 0 1 2.11-.45c.94.35 1.9.59 2.9.72A2 2 0 0 1 22 16.92z" /></svg>
          Call 704-332-4111
        </Button>
        <Button href="https://maps.google.com/maps?daddr=4225+Monroe+Rd,+Charlotte,+NC+28205" variant="outline" target="_blank" rel="noopener">
          Get Directions
        </Button>
      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
  .white { color: var(--white); }

  /* ── Page hero ── */
  .page-hero {
    padding: calc(var(--header-height) + 3rem) 0 2.25rem;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .page-hero-photo {
    position: absolute;
    inset: 0;
    background-image: url('/images/about-hero-shop.jpg');
    background-size: cover;
    background-position: center 35%;
    opacity: .4;
  }
  .page-hero-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(160deg, rgba(6, 6, 6, 0) 0%, var(--bg) 100%),
      radial-gradient(ellipse at 70% -10%, rgba(201, 168, 76, .07) 0%, transparent 55%);
  }
  .page-hero-content { position: relative; z-index: 1; text-align: center; }
  .page-hero h1 { margin-bottom: .65rem; }
  .page-hero h1 em { font-style: italic; color: var(--gold); }
  .page-hero p { max-width: 560px; margin-inline: auto; font-size: 1rem; color: var(--text); }

  /* ── Story ── */
  .story-section { background: var(--bg); }
  .story-inner { display: grid; grid-template-columns: 1fr 1.25fr; gap: 4.5rem; align-items: start; }
  .story-aside { position: sticky; top: 90px; }
  .story-quote {
    border-left: 2px solid var(--gold);
    padding: 1.25rem 1.5rem 1.25rem 1.75rem;
    background: var(--bg-card);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    margin-bottom: 1.5rem;
  }
  .story-quote p { font-family: var(--font-serif); font-size: 1.2rem; font-style: italic; color: var(--white); line-height: 1.6; }
  .story-milestones { display: flex; flex-direction: column; gap: .65rem; }
  .milestone { display: flex; gap: .9rem; align-items: center; }
  .milestone-year { font-family: var(--font-serif); font-size: 1.05rem; font-weight: 600; color: var(--gold); min-width: 46px; }
  .milestone-text { font-size: .875rem; color: var(--text-muted); border-left: 1px solid var(--border); padding-left: .9rem; }
  .story-content p { margin-bottom: 1.15rem; font-size: 1rem; }

  /* ── Team ── */
  .team-section { background: var(--bg-card); }
  .team-photo {
    margin-top: 3rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .team-photo-img {
    background-image: url('/images/team-shop-floor.jpg');
    background-size: cover;
    background-position: center 38%;
    height: 320px;
  }
  .team-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-top: 1.5rem; }
  .team-card { background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
  .team-card-header {
    background: linear-gradient(135deg, var(--bg-card-2), var(--bg-card));
    border-bottom: 1px solid var(--border);
    padding: 2rem 1.75rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .team-avatar {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: rgba(201, 168, 76, .08);
    border: 1.5px solid rgba(201, 168, 76, .22);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--gold);
    flex-shrink: 0;
  }
  .team-title { font-size: .62rem; letter-spacing: .16em; text-transform: uppercase; color: var(--gold); margin-bottom: .25rem; }
  .team-name { font-family: var(--font-serif); font-size: 1.25rem; color: var(--white); }
  .team-card-body { padding: 1.6rem 1.75rem; }
  .team-card-body p { font-size: 1rem; line-height: 1.75; color: var(--text); }

  /* ── Values ── */
  .values-section { background: var(--bg); }
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-top: 3rem;
  }
  .value-card { background: var(--bg-card); padding: 1.75rem; }
  .value-icon {
    width: 38px;
    height: 38px;
    background: var(--gold-faint);
    border: 1px solid rgba(201, 168, 76, .12);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gold);
    margin-bottom: 1rem;
  }
  .value-card h4 { color: var(--white); margin-bottom: .4rem; }
  .value-card p { font-size: 1rem; color: var(--text-muted); }

  /* ── Warranty ── */
  .warranty-section { background: var(--bg-card); }
  .warranty-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .warranty-badge-wrap { display: flex; justify-content: center; }
  .warranty-badge {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    border: 1.5px solid rgba(201, 168, 76, .28);
    background: radial-gradient(circle at center, rgba(201, 168, 76, .06), transparent 70%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
  }
  .warranty-badge::before {
    content: '';
    position: absolute;
    inset: 7px;
    border-radius: 50%;
    border: 1px solid rgba(201, 168, 76, .1);
  }
  .warranty-years { font-family: var(--font-serif); font-size: 3.5rem; font-weight: 600; color: var(--gold); line-height: 1; }
  .warranty-badge-label { font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; color: var(--text-muted); margin-top: .2rem; }
  .warranty-content p { margin-bottom: .9rem; font-size: 1rem; color: var(--text); }
  .warranty-points { margin-top: 1.25rem; display: flex; flex-direction: column; gap: .65rem; }
  .warranty-point { display: flex; gap: .65rem; align-items: flex-start; font-size: 1rem; color: var(--text); }
  .warranty-point svg { color: var(--gold); flex-shrink: 0; margin-top: 2px; }

  /* ── Specialization ── */
  .spec-section { background: var(--bg); }
  .spec-inner {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
    margin-top: 3rem;
  }
  .spec-brands { display: flex; flex-direction: column; gap: .85rem; }
  .spec-brand {
    display: flex;
    align-items: center;
    gap: .9rem;
    padding: 1.1rem 1.25rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .spec-brand-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--gold-faint);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: .7rem;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: .04em;
  }
  .spec-brand-name { font-size: .9rem; color: var(--white); font-weight: 500; }
  .spec-brand-note { font-size: .875rem; color: var(--text-muted); }
  .spec-content p { margin-bottom: .9rem; font-size: 1rem; color: var(--text); }
  .spec-note {
    margin-top: 1.5rem;
    padding: .9rem 1.1rem;
    background: rgba(201, 168, 76, .03);
    border-left: 2px solid var(--gold-dark);

---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Button from '../components/Button.astro';

const faqs = [
  {
    q: 'Do you only work on BMW and Mercedes-Benz?',
    a: 'Yes. We specialize exclusively in BMW and Mercedes-Benz vehicles. This focus allows us to provide dealer-level expertise at independent shop prices.',
  },
  {
    q: 'Do you work on hybrid or electric vehicles?',
    a: 'No. At this time we do not service hybrid or electric vehicles. We focus on traditional combustion engine BMW and Mercedes-Benz models.',
  },
  {
    q: 'Do I need an appointment?',
    a: 'appointment', // rendered specially below to keep the tel: link live
  },
  {
    q: 'What does your warranty cover?',
    a: "All parts and labor performed at our shop come with a 12-month, unlimited-mile warranty. If something isn't right, we make it right.",
  },
  {
    q: 'How long does a typical service take?',
    a: 'Most maintenance services are completed the same day. More complex repairs may take 1–2 days. We will always give you a clear timeline before starting any work.',
  },
  {
    q: 'How do your prices compare to the dealership?',
    a: 'Our customers consistently tell us we charge significantly less than dealerships — while delivering the same or better quality of work, because we specialize in exactly these vehicles.',
  },
  {
    q: 'Where are you located and what are your hours?',
    a: 'We are at 4225 Monroe Rd, Charlotte, NC 28205. Open Monday through Friday, 8:00am to 5:00pm. Closed on weekends.',
  },
  {
    q: 'What should I do if my check engine light comes on?',
    a: 'checkengine', // also needs a live tel: link
  },
];
---

<BaseLayout
  title="FAQ — Charlotte Star Service | BMW & Mercedes-Benz Specialists"
  description="Frequently asked questions about Charlotte Star Service — BMW and Mercedes-Benz specialists in Charlotte, NC. Hours, warranty, pricing, appointments and more."
>
  <SiteHeader />

  <!-- ── PAGE HERO ── -->
  <div class="page-hero">
    <div class="page-hero-bg"></div>
    <div class="container">
      <div class="page-hero-content" data-reveal>
        <span class="section-label">Common Questions</span>
        <h1>Frequently Asked<br /><em>Questions</em></h1>
        <div class="divider center"></div>
        <p>
          Everything you need to know about bringing your BMW or Mercedes-Benz
          to Charlotte Star Service. Still have a question?
          Call us at <a href="tel:7043324111" class="gold-link">704-332-4111</a>.
        </p>
      </div>
    </div>
  </div>

  <!-- ── FAQ ── -->
  <section class="faq-section">
    <div class="container">
      <div class="faq-list" data-reveal>
        {faqs.map((item, i) => (
          <div class={`faq-item ${i === 0 ? 'open' : ''}`}>
            <button class="faq-question" aria-expanded={i === 0 ? 'true' : 'false'}>
              <span class="faq-question-text">{item.q}</span>
              <span class="faq-chevron">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
              </span>
            </button>
            <div class="faq-answer">
              {item.a === 'appointment' ? (
                <p>
                  Yes, we recommend scheduling an appointment by calling{' '}
                  <a href="tel:7043324111">704-332-4111</a> so we can give your vehicle the
                  dedicated time it deserves.
                </p>
              ) : item.a === 'checkengine' ? (
                <p>
                  Call us at <a href="tel:7043324111">704-332-4111</a> and schedule a diagnostic
                  appointment as soon as possible. We'll identify the issue and explain exactly
                  what needs to be done before touching anything.
                </p>
              ) : (
                <p>{item.a}</p>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- CTA below FAQ -->
      <div class="faq-cta" data-reveal style="transition-delay: 90ms;">
        <h3>Still Have Questions?</h3>
        <p>
          The best answers come from a real conversation. Give Dan and Joe a call —
          they are happy to talk through your vehicle's situation before you even book.
        </p>
        <div class="faq-cta-buttons">
          <Button href="tel:7043324111" variant="primary">
            <svg slot="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.44 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.13 1 .37 1.96.72 2.9a2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6.09 6.09l.98-.98a2 2 0 0 1 2.11-.45c.94.35 1.9.59 2.9.72A2 2 0 0 1 22 16.92z" /></svg>
            Call 704-332-4111
          </Button>
          <Button href="/about" variant="outline">Learn About Us</Button>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
  /* ── Page hero — plain gradient, no photo (same as the live site;
       a text-focused Q&A page doesn't need one). ── */
  .page-hero {
    padding: calc(var(--header-height) + 3rem) 0 2.25rem;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .page-hero-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(160deg, rgba(6, 6, 6, 0) 0%, var(--bg) 100%),
      radial-gradient(ellipse at 70% -10%, rgba(201, 168, 76, .07) 0%, transparent 55%);
  }
  .page-hero-content { position: relative; z-index: 1; text-align: center; }
  .page-hero h1 { margin-bottom: .65rem; }
  .page-hero h1 em { font-style: italic; color: var(--gold); }
  .page-hero p { max-width: 560px; margin-inline: auto; font-size: 1rem; color: var(--text); }
  .gold-link { color: var(--gold); }

  /* ── FAQ ── */
  .faq-section { background: var(--bg); padding-top: 2.5rem; }
  .faq-list {
    max-width: 780px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .faq-item {
    border-bottom: 1px solid var(--border);
    background: var(--bg-card);
    transition: background .2s, border-left-color .2s;
    border-left: 2px solid transparent;
  }
  .faq-item:last-child { border-bottom: none; }
  .faq-item.open { background: var(--bg-card-2); border-left-color: var(--gold); }
  .faq-question {
    width: 100%;
    background: none;
    border: none;
    padding: 1.4rem 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    text-align: left;
  }
  .faq-question-text {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: #e8e2d8;
    font-weight: 400;
    line-height: 1.4;
  }
  .faq-chevron {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(201, 168, 76, .06);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gold);
    flex-shrink: 0;
    transition: transform .28s, background .2s;
  }
  .faq-item.open .faq-chevron {
    transform: rotate(180deg);
    background: rgba(201, 168, 76, .14);
    border-color: rgba(201, 168, 76, .25);
  }
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height .32s ease, padding .28s ease;
    padding: 0 1.75rem;
  }
  .faq-item.open .faq-answer { max-height: 400px; padding: 0 1.75rem 1.5rem; }
  .faq-answer p {
    font-size: 1rem;
    color: #c8c2b8;
    line-height: 1.8;
    padding-left: 1rem;
    border-left: 1px solid rgba(201, 168, 76, .2);
  }
  .faq-cta {
    max-width: 780px;
    margin-inline: auto;
    margin-top: 2.5rem;
    padding: 2.25rem;
    background: var(--bg-card);
    border: 1px solid rgba(201, 168, 76, .14);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .faq-cta h3 { color: var(--white); margin-bottom: .65rem; }
  .faq-cta p { margin-bottom: 1.35rem; font-size: 1rem; color: var(--text); }
  .faq-cta-buttons { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
</style>

<script>
  // Single-open accordion — clicking a question closes any other open
  // one, matching the plain-HTML site's behavior exactly.
  document.querySelectorAll<HTMLButtonElement>('.faq-question').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      if (!item) return;
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach((i) => {
        i.classList.remove('open');
        i.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
